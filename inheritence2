class animal{
    void sound(){
        System.out.println("animals makes a sound");
    }
}
class dog extends animal{
    void sound(){
        System.out.println("dog barks");
    }
}
class cat extends animal{
    void sound(){
        System.out.println("cat meows");
    }
}
class main{
    public static void main(String [] args){
        animal s;
        s=new dog();
        s.sound();
         s=new cat();
         s.sound();
    }
}
