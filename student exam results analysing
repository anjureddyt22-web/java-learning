import java.util.*;
class student{
    public static void main(String[] args){
    Scanner sc=new Scanner(System.in);
    String []a=new String[5];
    int [][] b= new int[5][5];
    
    for(int i=0;i<a.length;i++){
      System.out.println("enetr the name");
        a [i] =sc.next();
    
    for(int j=0;j<b.length;j++){
        System.out.println("enter the marks of " +(j+1)+ "subject");
        b [i][j]=sc.nextInt();
       
    }
    }
    for(int i=0;i<a.length;i++){
        int total=0;
        int max=b[i][0];
        int min=b[i][0];
        int pass=0;
        for(int j=0;j<b.length;j++){
            total=total+b[i][j];
            if(b[i][j]>max)
                max=b[i][j];
            if(b[i][j]<min)
                min=b[i][j];
            if(b[i][j]>=40)
                pass++;
        }
    
    double average=(double)total/2;
    System.out.println("student: "+a[i]);
    System.out.println("total: "+total);
    System.out.println("average: "+average);
    System.out.println("higest marks: "+max);
    System.out.println("lowest marks: "+min);
    System.out.println("passed subjects: "+pass);
    

    }
}
    
}

