import java.util.*;
class uni{
        public void ans(int a[]){
             for(int j=0;j<a.length;j++){
            int count=0;
            for(int i=0;i<a.length;i++){
                    if(a[j]==a[i]){
                      count++;
                    }
                }
                    if(count==1){
                        System.out.print(a[j]+" ");
                    }
                }
           
        }
        public static void main(String [] args){
            Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int []a=new int[n];
        for(int i=0;i<a.length;i++){
            a [i]=sc.nextInt();
        }
        uni s=new uni();
       s.ans(a);
        }
}
