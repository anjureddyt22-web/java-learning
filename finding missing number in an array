import java.util.*;
class sum{
    public int add(int ar[]){
       int n=ar.length;
       int sum=0;
        for(int i=0;i<n;i++){
              sum+=ar[i];
        }
        int a=n*(n+1)/2;
        int an=a-sum;
        return an;
    }
    public static void main(String [] args){
        Scanner sc=new Scanner(System.in);
        int r=sc.nextInt();
        int []ar=new int[r];
        for(int i=0;i<ar.length;i++){
            ar [i]=sc.nextInt();
        }
        sum s=new sum();
        int re=s.add(ar);
           System.out.println(re);
    }
}
