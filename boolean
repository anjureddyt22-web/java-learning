import java.util.*;
class prime{
    boolean pri(int n){
        int cnt=0;
         
        for(int i=2;i<n/2;i++){
            
            if(n%i==0){
                cnt++;
            }
        }
            if(cnt==0){
            
                return true;
            }
            else{
                return false;
            }
        
    }
    public static void main(String [] args){
        prime p1=new prime();
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        System.out.println(p1.pri(n));

    }
}
